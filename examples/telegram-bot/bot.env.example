# Settings for the master-dns sample bot. Copy to /etc/master-dns-bot.env,
# fill in, and keep it readable by root only: chmod 600.

# From @BotFather.
BOT_TOKEN=

# The panel's bot API - the address the admin panel's API page shows.
API_URL=https://panel.example.com:8445/api/v1

# A key from the admin panel's API page. Tick "admin rights" when making it if
# you put your own Telegram id in ADMIN_IDS below.
API_KEY=dd_

# On the same page, give that key the webhook address
#     http://127.0.0.1:18990/
# and paste the signing secret it shows here.
WEBHOOK_SECRET=whsec_
LISTEN=127.0.0.1:18990

# Your own Telegram id (ask @userinfobot), comma separated for several.
# Leave empty for a bot that only serves customers.
ADMIN_IDS=

# Where to pay is set in the admin panel's Payment page. The bot
# reads it from there. This is only for a panel where that is empty.
PAY_TEXT=

# Optional: shown under "help".
SUPPORT_TEXT=

# Optional: a channel a customer must join before the bot serves them - a
# public one as @name, a private one by its number (-100...) with its
# invitation link in JOIN_LINK. The bot has to be an admin of the channel:
# Telegram tells only an admin who is in it.
JOIN_CHANNEL=
JOIN_LINK=

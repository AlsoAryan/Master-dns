        mine = self.store.one("SELECT name FROM plans WHERE id = ?",
                              (user["plan_id"],)) if user["plan_id"] else None
        waiting = self.store.one(
            "SELECT t.created_at, p.name FROM transactions t"
            " LEFT JOIN plans p ON p.id = t.plan_id"

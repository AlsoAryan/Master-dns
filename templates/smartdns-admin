                           "سرویس‌هایی که بعداً اضافه شوند</td><td></td></tr>"
                           % (name, users))
                continue
            groups = STORE.template_groups(t["id"])
            off = STORE.template_domains_off(t["id"])
            n_groups = n_dom = total_dom = 0
            for svc in catalogue_now():
                for g in svc["groups"]:

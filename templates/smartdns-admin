def users_view(handler):
    """The search the users table was on and how many of its rows were
    showing, as the page noted them when a form on it was sent: what an
    action on one of its rows goes back to."""
    try:
        jar = http.cookies.SimpleCookie(
            (getattr(handler, "headers", None) or {}).get("Cookie", "") or "")
        view = urllib.parse.unquote(jar["uview"].value) if "uview" in jar else ""
    except http.cookies.CookieError:
        return []
    keep = urllib.parse.parse_qs(view.lstrip("?"))
    out = []
    q = (keep.get("q") or [""])[0][:64].replace("&", " ").replace("=", " ")
    if q:

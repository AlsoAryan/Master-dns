                       "</td><td>%s</td><td>%s</td><td>%d٪</td></tr>"
                       % (p, r["id"], html.escape(who), html.escape(r["first_name"] or ""),
                          human(r["down"]), human(r["up"]),
                          round(100.0 * (r["down"] + r["up"]) / total)))

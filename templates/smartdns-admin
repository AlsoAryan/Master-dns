            "<linearGradient id='mg' x1='0' y1='0' x2='1' y2='1'>"
            "<stop offset='0' stop-color='var(--accent)'/>"
            "<stop offset='1' stop-color='var(--accent2)'/></linearGradient></defs>"
            "<rect width='32' height='32' rx='10' fill='url(#mg)'/>"

    out.append("<h3 class='chart-h'>سرعت کل ۲۴ ساعت اخیر</h3>" + legend() + speed_chart(view["five"]))
    out.append("<h3 class='chart-h'>ساعت‌های پرمصرف — ۷ روز اخیر</h3>" + heat_chart(view["hours"]))
    if top:
        total = sum(week) or 1
